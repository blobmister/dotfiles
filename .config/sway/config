set $mod Mod4
set $menu fuzzel
set $term kitty


# Enable waybar
exec waybar

# App launcher
bindsym $mod+space exec $menu

# Terminal
bindsym $mod+Return exec $term

# Basic keybinds

bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

# --- Navigation ---
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down
bindsym $mod+f fullscreen toggle

# --- Workspaces ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3

# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Special keys to control media via playerctl                                              
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# Special keys to adjust brightness via brightnessctl                                      
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+


# Screenshot Config
# 1. Region / Area Selection
bindsym Print exec bash -c 'mkdir -p ~/Pictures/Screenshots && grim -g "$(slurp)" ~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png && wl-copy < ~/Pictures/Screenshots/$(ls -t ~/Pictures/Screenshots | head -n 1)'
# 2. Focused Window Only
bindsym $mod+p exec bash -c 'mkdir -p ~/Pictures/Screenshots && FILE=~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png && grim -g "$(swaymsg -t get_tree | jq -r ".. | select(.focused? == true).rect | \"\(.x),\(.y) \(.width)x\(.height)\"")" "$FILE" && wl-copy < "$FILE"'
# 3. Full Screen / Output
bindsym $mod+Ctrl+p exec bash -c 'mkdir -p ~/Pictures/Screenshots && FILE=~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png && grim "$FILE" && wl-copy < "$FILE"'
# 4. Region Selection with Quick Annotation Editor (Swappy)
bindsym $mod+Shift+p exec grim -g "$(slurp)" - | swappy -f -

# Special key to start an application with wmenu-run                                       
bindsym XF86Search exec $menu

# Theming
include colorscheme

# Basic color configuration using the Base16 variables for windows and borders.
# Property Name         Border  BG      Text    Indicator Child Border
client.focused          $base05 $base0D $base00 $base0D $base0D
client.focused_inactive $base01 $base01 $base05 $base03 $base01
client.unfocused        $base01 $base00 $base05 $base01 $base01
client.urgent           $base08 $base08 $base00 $base08 $base08
client.placeholder      $base00 $base00 $base05 $base00 $base00
client.background       $base07

smart_borders on
default_border pixel 1
default_floating_border pixel 1

# Waybar icons
exec blueman-applet
exec pasystray
exec nm-applet --indicator
for_window [app_id="pavucontrol"] floating enable, resize set 700 500
for_window [app_id="blueman-manager"] floating enable, resize set 800 600, move position center


# External screen setup
bindsym XF86Display exec nwg-displays
for_window [app_id="nwg-displays"] floating enable, move position center

# Make scrolling direction normal
input type:touchpad {
    natural_scroll enabled
}

# Set system wide config to dark mode
exec_always {
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
}
